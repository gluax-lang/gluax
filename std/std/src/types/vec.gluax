import "../debug";
import "../base";

// impl<T> vec<T> {
//     #[inline]
//     func __x_iter_range_bound(self) -> number { self.len() }
//
//     #[inline]
//     func __x_iter_range(self, idx: number) -> T {
//         @raw("{@RETURN {@1@}[{@2@}] @}", self, idx) -> T
//     }
// }

impl vec<any> {
    #[inline]
    pub func push(self, v: vec_T) {
        @raw("do local self = {@1@}; self[#self+1] = {@2@} end;", self, v)@;
    }

    #[inline]
    pub func insert(self, idx: number, v: vec_T) {
        let len = #self;
        if idx < 1 || idx > len + 1 {
            base::errorf("vec.insert: index %s out of bounds [1, %s]", idx, len + 1);
        }
        @raw("table.insert({@1@}, {@2@}, {@3@});", self, idx, v)@;
    }

    #[global = "table.remove"]
    pub func remove(self, idx: number) -> ?vec_T;

    #[inline]
    pub func reverse(self) {
        @raw("do local self = {@1@}; local len = #self; for i = 1, math.floor(len / 2) do self[i], self[len - i + 1] = self[len - i + 1], self[i] end end;", self)@;
    }

    #[inline]
    pub func pop(self) -> ?vec_T {
        @raw("do local self = {@1@}; local len = #self; if len == 0 then {@TEMP1@} = nil else {@TEMP1@}, self[len] = self[len], nil; end {@RETURN {@TEMP1@} @} end;", self) -> ?vec_T@
    }

    #[global = "table.sort"]
    pub func sort(self, cmp: ?func(vec_T, vec_T) -> bool);

    #[global = "unpack"]
    pub func unpack(self, s: ?number, e: ?number) -> ...vec_T;

    #[inline]
    pub func is_empty(self) -> bool { #self == 0 }
}

impl vec<number | string> {
    pub func join(self, sep: ?string, s: ?number, e: ?number) -> string {
        debug::assert(if s {
            s? >= 1
        } else {
            true
        }, "vec.join: start index must be greater than or equal to 1, got %s", s);
        debug::assert(if e {
            e? <= #self
        } else {
            true
        }, "vec.join: end index must be less than or equal to the length of the vector, got %s, length is %s", e, #self);
        table::join(self unsafe_cast_as table, sep, s, e)
    }
}
